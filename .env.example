# ---- Schwab Trader API ----------------------------------------------------
# Schwab access comes from the central schwab_hub (../schwab_hub/run.sh); no credentials here.

# ---- Grading (optional paid path) -----------------------------------------
# Leave ANTHROPIC_API_KEY empty to use the FREE copy-paste loop with
# Claude.ai (`python run.py export` / `python run.py ingest`).
ANTHROPIC_API_KEY=
GRADER_MODEL=claude-fable-5

# ---- Optional -------------------------------------------------------------
# Only needed if you later backfill market context for old trades.
POLYGON_API_KEY=
