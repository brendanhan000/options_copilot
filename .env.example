# ---- Schwab Trader API ----------------------------------------------------
# Create an app at https://developer.schwab.com. The app must have BOTH
# "Accounts and Trading Production" AND "Market Data Production" added, and
# must be in status "Ready For Use". The callback URL registered on the app
# must match SCHWAB_CALLBACK_URL below EXACTLY (scheme, host, port).
SCHWAB_APP_KEY=
SCHWAB_APP_SECRET=
SCHWAB_CALLBACK_URL=https://127.0.0.1:8182

# ---- Grading (optional paid path) -----------------------------------------
# Leave ANTHROPIC_API_KEY empty to use the FREE copy-paste loop with
# Claude.ai (`python run.py export` / `python run.py ingest`).
ANTHROPIC_API_KEY=
GRADER_MODEL=claude-fable-5

# ---- Optional -------------------------------------------------------------
# Only needed if you later backfill market context for old trades.
POLYGON_API_KEY=
